# Copy to .env:  cp .env.example .env

# PostgreSQL connection string.
# Local Docker (see docker-compose.yml): the value below works as-is.
# Neon / Supabase: paste the connection string from their dashboard.
DATABASE_URL="postgresql://swee:swee@localhost:5432/swee_dev"

# Better Auth. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
